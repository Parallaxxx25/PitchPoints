  "$defs": {
    "FantasySquad": {
      "additionalProperties": false,
      "description": "Eleven players from the match; the captain's points count twice.",
      "properties": {
        "players": {
          "items": {
            "type": "string"
          },
          "maxItems": 11,
          "minItems": 11,
          "type": "array"
        },
        "captain_id": {
          "type": "string"
        },
        "vice_captain_id": {
          "type": "string"
        }
      },
      "required": [
        "players",
        "captain_id",
        "vice_captain_id"
      ],
      "title": "FantasySquad",
      "type": "object"
    },
    "KeyMoment": {
      "additionalProperties": false,
      "description": "A moment worth explaining. `importance` (0 to 1) is the win-probability swing it caused,\nor the type's base importance when that is larger. `facts` holds every number an agent\nmay quote about it.",
      "properties": {
        "kind": {
          "const": "moment",
          "default": "moment",
          "type": "string"
        },
        "id": {
          "type": "integer"
        },
        "match_id": {
          "type": "string"
        },
        "period": {
          "enum": [
            1,
            2
          ],
          "type": "integer"
        },
        "clock_s": {
          "type": "number"
        },
        "minute": {
          "type": "integer"
        },
        "type": {
          "enum": [
            "goal",
            "big_chance",
            "save",
            "card",
            "momentum_swing",
            "pressure_spell",
            "milestone"
          ],
          "type": "string"
        },
        "importance": {
          "type": "number"
        },
        "team_id": {
          "type": "string"
        },
        "player_ids": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "facts": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "integer"
              },
              {
                "type": "number"
              },
              {
                "type": "boolean"
              }
            ]
          },
          "type": "object"
        },
        "source_event_ids": {
          "items": {
            "type": "integer"
          },
          "minItems": 1,
          "type": "array"
        }
      },
      "required": [
        "kind",
        "id",
        "match_id",
        "period",
        "clock_s",
        "minute",
        "type",
        "importance",
        "team_id",
        "player_ids",
        "facts",
        "source_event_ids"
      ],
      "title": "KeyMoment",
      "type": "object"
    },
    "LedgerEntry": {
      "additionalProperties": false,
      "description": "One change to a player's fantasy points.\n\nEntries that can still change (clean sheet, goals conceded, bonus) are\n`provisional` and keep a stable `id`: a later entry with the same id replaces\nthe earlier one, and its `running_total` already reflects the replacement.\nAt full time every provisional entry is issued again with `provisional` false.",
      "properties": {
        "kind": {
          "const": "ledger_entry",
          "default": "ledger_entry",
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "match_id": {
          "type": "string"
        },
        "player_id": {
          "type": "string"
        },
        "minute": {
          "type": "integer"
        },
        "delta": {
          "type": "integer"
        },
        "running_total": {
          "type": "integer"
        },
        "rule_id": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        },
        "source_event_ids": {
          "items": {
            "type": "integer"
          },
          "minItems": 1,
          "type": "array"
        },
        "provisional": {
          "type": "boolean"
        }
      },
      "required": [
        "kind",
        "id",
        "match_id",
        "player_id",
        "minute",
        "delta",
        "running_total",
        "rule_id",
        "reason",
        "source_event_ids",
        "provisional"
      ],
      "title": "LedgerEntry",
      "type": "object"
    },
    "LiveMessage": {
      "discriminator": {
        "mapping": {
          "event": "#/$defs/MatchEvent",
          "ledger_entry": "#/$defs/LedgerEntry",
          "match_state": "#/$defs/MatchState",
          "metadata": "#/$defs/MatchMetadata",
