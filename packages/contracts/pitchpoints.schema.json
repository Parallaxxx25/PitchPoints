          "$ref": "#/$defs/LedgerEntry"
        },
        {
          "$ref": "#/$defs/OverlayCue"
        },
        {
          "$ref": "#/$defs/SquadTotal"
        }
      ]
    },
    "MatchControl": {
      "additionalProperties": false,
      "description": "Change a running match; unset fields stay as they are. A seek is applied first.",
      "properties": {
        "seek_minute": {
          "anyOf": [
            {
              "maximum": 120,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "paused": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "speed": {
          "anyOf": [
            {
              "enum": [
                1,
                6,
                18,
                60
              ],
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "seek_minute",
        "paused",
        "speed"
      ],
      "title": "MatchControl",
      "type": "object"
    },
    "MatchEvent": {
      "additionalProperties": false,
      "description": "One match event. Type-specific fields are null unless the type uses them.\n\n`opponent_id` is the other-team player involved: the player pressed, tackled,\nor fouled, or the shooter for `block` and `save`. `possession_change` is\nemitted just before the event that wins the ball. A penalty miss is a `shot`\nwith `penalty` true and an outcome other than `goal`.",
      "properties": {
        "kind": {
          "const": "event",
          "default": "event",
          "type": "string"
        },
        "id": {
          "type": "integer"
        },
        "match_id": {
          "type": "string"
        },
        "period": {
          "enum": [
            1,
            2
          ],
          "type": "integer"
        },
        "clock_s": {
          "type": "number"
        },
        "minute": {
          "type": "integer"
        },
        "type": {
          "enum": [
            "match_start",
            "kickoff",
            "pass",
            "carry",
            "pressure",
            "possession_change",
            "shot",
            "goal",
            "own_goal",
            "save",
            "block",
            "tackle",
            "interception",
            "clearance",
            "ball_recovery",
            "foul",
            "card",
            "penalty_won",
            "corner",
            "substitution",
            "period_end",
            "match_end"
          ],
          "type": "string"
        },
        "team_id": {
          "type": "string"
        },
        "player_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "possession_id": {
          "type": "integer"
        },
        "x": {
          "anyOf": [
            {
              "maximum": 105.0,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "y": {
          "anyOf": [
            {
              "maximum": 68.0,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "end_x": {
          "anyOf": [
            {
              "maximum": 105.0,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "end_y": {
          "anyOf": [
            {
              "maximum": 68.0,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "outcome": {
          "anyOf": [
            {
              "enum": [
                "complete",
                "incomplete",
                "goal",
                "saved",
                "blocked",
                "off_target",
                "won"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "recipient_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "opponent_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "cross": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "under_pressure": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null
