{
  "$defs": {
    "MatchEvent": {
      "additionalProperties": false,
      "description": "One match event. Type-specific fields are null unless the type uses them.\n\n`opponent_id` is the other-team player involved: the player pressed, tackled,\nor fouled, or the shooter for `block` and `save`. `possession_change` is\nemitted just before the event that wins the ball. A penalty miss is a `shot`\nwith `penalty` true and an outcome other than `goal`.",
      "properties": {
        "kind": {
          "const": "event",
          "default": "event",
          "type": "string"
        },
        "id": {
          "type": "integer"
        },
        "match_id": {
          "type": "string"
        },
        "period": {
          "enum": [
            1,
            2
          ],
          "type": "integer"
        },
        "clock_s": {
          "type": "number"
        },
        "minute": {
          "type": "integer"
        },
        "type": {
          "enum": [
            "match_start",
            "kickoff",
            "pass",
            "carry",
            "pressure",
            "possession_change",
            "shot",
            "goal",
            "own_goal",
            "save",
            "block",
            "tackle",
            "interception",
            "clearance",
            "ball_recovery",
            "foul",
            "card",
            "penalty_won",
            "corner",
            "substitution",
            "period_end",
            "match_end"
          ],
          "type": "string"
        },
        "team_id": {
          "type": "string"
        },
        "player_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "possession_id": {
          "type": "integer"
        },
        "x": {
          "anyOf": [
            {
              "maximum": 105.0,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "y": {
          "anyOf": [
            {
              "maximum": 68.0,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "end_x": {
          "anyOf": [
            {
              "maximum": 105.0,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "end_y": {
          "anyOf": [
            {
              "maximum": 68.0,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "outcome": {
          "anyOf": [
            {
              "enum": [
                "complete",
                "incomplete",
                "goal",
                "saved",
                "blocked",
                "off_target",
                "won"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "recipient_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "opponent_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "cross": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "under_pressure": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "ball_speed_kmh": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "xg": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "shot_speed_kmh": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "penalty": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "assist_player_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "card": {
          "anyOf": [
            {
              "enum": [
                "yellow",
                "second_yellow",
                "red"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "player_in_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "score": {
          "anyOf": [
            {
              "additionalProperties": {
                "type": "integer"
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "kind",
        "id",
        "match_id",
        "period",
        "clock_s",
        "minute",
        "type",
        "team_id",
        "player_id",
        "possession_id",
        "x",
        "y",
        "end_x",
        "end_y",
        "outcome",
        "recipient_id",
        "opponent_id",
        "cross",
        "under_pressure",
        "ball_speed_kmh",
        "xg",
        "shot_speed_kmh",
        "penalty",
        "assist_player_id",
        "card",
        "player_in_id",
        "score"
      ],
      "title": "MatchEvent",
      "type": "object"
    },
    "MatchMetadata": {
      "additionalProperties": false,
      "description": "Fixture details, sent once before the first event. All names are fictional.",
      "properties": {
        "kind": {
          "const": "metadata",
          "default": "metadata",
          "type": "string"
        },
        "match_id": {
          "type": "string"
        },
        "competition": {
          "type": "string"
        },
        "season": {
          "type": "string"
        },
        "matchday": {
          "type": "integer"
        },
        "venue": {
          "type": "string"
        },
        "city": {
          "type": "string"
        },
        "kickoff_utc": {
          "format": "date-time",
          "type": "string"
        },
        "weather": {
          "enum": [
            "clear",
            "cloudy",
            "rain",
            "wind",
            "cold"
          ],
          "type": "string"
        },
        "temperature_c": {
          "type": "integer"
        },
        "referee": {
          "type": "string"
        },
        "attendance": {
          "type": "integer"
        },
        "home": {
          "$ref": "#/$defs/TeamSheet"
        },
        "away": {
          "$ref": "#/$defs/TeamSheet"
        }
      },
      "required": [
        "kind",
        "match_id",
        "competition",
        "season",
        "matchday",
        "venue",
        "city",
        "kickoff_utc",
        "weather",
        "temperature_c",
        "referee",
        "attendance",
        "home",
        "away"
      ],
      "title": "MatchMetadata",
      "type": "object"
    },
    "PlayerInfo": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "shirt": {
          "type": "integer"
        },
        "position": {
          "enum": [
            "GK",
            "DEF",
            "MID",
            "FWD"
          ],
          "type": "string"
        }
      },
      "required": [
        "id",
        "name",
        "shirt",
        "position"
      ],
      "title": "PlayerInfo",
      "type": "object"
    },
    "PlayerPosition": {
      "additionalProperties": false,
      "properties": {
        "player_id": {
          "type": "string"
        },
        "x": {
          "maximum": 105.0,
          "minimum": 0,
          "type": "number"
        },
        "y": {
          "maximum": 68.0,
          "minimum": 0,
          "type": "number"
        },
        "speed_kmh": {
          "type": "number"
        }
      },
      "required": [
        "player_id",
        "x",
        "y",
        "speed_kmh"
      ],
      "title": "PlayerPosition",
      "type": "object"
    },
    "PositionFrame": {
      "additionalProperties": false,
      "description": "Approximate positions of the ball and every on-pitch player, about every 2 seconds.",
      "properties": {
        "kind": {
          "const": "positions",
          "default": "positions",
          "type": "string"
        },
        "match_id": {
          "type": "string"
        },
        "period": {
          "enum": [
            1,
            2
          ],
          "type": "integer"
        },
        "clock_s": {
          "type": "number"
        },
        "ball_x": {
          "maximum": 105.0,
          "minimum": 0,
          "type": "number"
        },
        "ball_y": {
          "maximum": 68.0,
          "minimum": 0,
          "type": "number"
        },
        "players": {
          "items": {
            "$ref": "#/$defs/PlayerPosition"
          },
          "type": "array"
        }
      },
      "required": [
        "kind",
        "match_id",
        "period",
        "clock_s",
        "ball_x",
        "ball_y",
        "players"
      ],
      "title": "PositionFrame",
      "type": "object"
    },
    "TeamSheet": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "short_name": {
          "type": "string"
        },
        "primary_colour": {
          "type": "string"
        },
        "secondary_colour": {
          "type": "string"
        },
        "formation": {
          "type": "string"
        },
        "starters": {
          "items": {
            "$ref": "#/$defs/PlayerInfo"
          },
          "type": "array"
        },
        "bench": {
          "items": {
            "$ref": "#/$defs/PlayerInfo"
          },
          "type": "array"
        }
      },
      "required": [
        "id",
        "name",
        "short_name",
        "primary_colour",
        "secondary_colour",
        "formation",
        "starters",
        "bench"
      ],
      "title": "TeamSheet",
      "type": "object"
    }
  },
  "discriminator": {
    "mapping": {
      "event": "#/$defs/MatchEvent",
      "metadata": "#/$defs/MatchMetadata",
      "positions": "#/$defs/PositionFrame"
    },
    "propertyName": "kind"
  },
  "oneOf": [
    {
      "$ref": "#/$defs/MatchMetadata"
    },
    {
      "$ref": "#/$defs/MatchEvent"
    },
    {
      "$ref": "#/$defs/PositionFrame"
    }
  ]
}
