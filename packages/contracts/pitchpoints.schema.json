          "squad_total": "#/$defs/SquadTotal",
          "stats": "#/$defs/StatSnapshot",
          "tactical_state": "#/$defs/TacticalState"
        },
        "propertyName": "kind"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/MatchMetadata"
        },
        {
          "$ref": "#/$defs/MatchState"
        },
        {
          "$ref": "#/$defs/MatchEvent"
        },
        {
